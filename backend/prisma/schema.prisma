generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  runtime             = "nodejs"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED
}

enum OrderStatus {
  RECEIVED
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model User {
  id           String @id @default(uuid()) @db.Uuid
  fullName     String @db.VarChar(120)
  phone        String @unique @db.VarChar(20)
  passwordHash String @db.VarChar(255)

  role          UserRole             @default(USER)
  isActive      Boolean              @default(true)
  sessions      Session[]
  favorites     Favorite[]
  cart          Cart?
  orders        Order[]
  couponUsages  CouponUsage[]
  statusChanges OrderStatusHistory[]
  addresses     Address[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model Address {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label       String? @db.VarChar(50)
  fullAddress String  @db.Text
  isDefault   Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

model Category {
  id String @id @default(uuid()) @db.Uuid

  name String @db.VarChar(120)
  slug String @unique @db.VarChar(140)

  imageUrl       String? @db.Text
  bannerImageUrl String? @db.Text
  bannerTitle    String? @db.VarChar(160)
  bannerSubtitle String? @db.VarChar(255)

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  subcategories Subcategory[]

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@index([isActive, sortOrder])
}

model Subcategory {
  id String @id @default(uuid()) @db.Uuid

  categoryId String   @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  name String @db.VarChar(120)
  slug String @db.VarChar(140)

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  products Product[]

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@unique([categoryId, slug])
  @@index([categoryId, isActive, sortOrder])
}

model Product {
  id String @id @default(uuid()) @db.Uuid

  subcategoryId String      @db.Uuid
  subcategory   Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)

  name        String  @db.VarChar(160)
  slug        String  @unique @db.VarChar(180)
  description String? @db.Text
  imageUrl    String  @db.Text
  unit        String  @db.VarChar(80)

  price Decimal @db.Decimal(12, 2)
  stock Int     @default(0)

  badge        String? @db.VarChar(80)
  deliveryText String? @db.VarChar(160)

  isBestSeller Boolean @default(false)
  isActive     Boolean @default(true)

  offer Offer?

  favorites  Favorite[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  ratingAverage Decimal @default(0) @db.Decimal(2, 1)
  reviewsCount  Int     @default(0)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@index([subcategoryId, isActive])
  @@index([isBestSeller, isActive])
}

model Offer {
  id String @id @default(uuid()) @db.Uuid

  productId String  @unique @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  discountPercentage Decimal @db.Decimal(5, 2)

  isActive Boolean @default(true)

  startsAt DateTime? @db.Timestamptz(3)
  endsAt   DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([isActive])
}

model Favorite {
  id String @id @default(uuid()) @db.Uuid

  userId    String @db.Uuid
  productId String @db.Uuid

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model Cart {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items CartItem[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model CartItem {
  id String @id @default(uuid()) @db.Uuid

  cartId    String @db.Uuid
  productId String @db.Uuid

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity Int @default(1)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
}

model Coupon {
  id String @id @default(uuid()) @db.Uuid

  code String @unique @db.VarChar(50)

  discountType CouponDiscountType
  value        Decimal            @db.Decimal(12, 2)

  minOrderAmount    Decimal? @db.Decimal(12, 2)
  maxDiscountAmount Decimal? @db.Decimal(12, 2)

  usageLimit   Int?
  usagePerUser Int?

  startsAt  DateTime? @db.Timestamptz(3)
  expiresAt DateTime? @db.Timestamptz(3)

  orders Order[]
  usages CouponUsage[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([isActive])
  @@index([startsAt, expiresAt])
}

model Order {
  id          String @id @default(uuid()) @db.Uuid
  orderNumber String @unique @db.VarChar(50)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  status OrderStatus @default(RECEIVED)

  customerName    String @db.VarChar(120)
  customerPhone   String @db.VarChar(20)
  deliveryAddress String @db.Text

  subtotal       Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  deliveryFee    Decimal @default(0) @db.Decimal(12, 2)
  total          Decimal @db.Decimal(12, 2)

  couponId   String? @db.Uuid
  coupon     Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode String? @db.VarChar(50)

  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  couponUsage   CouponUsage?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([couponId])
}

model OrderItem {
  id String @id @default(uuid()) @db.Uuid

  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?  @db.Uuid
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  productName     String  @db.VarChar(160)
  productImageUrl String? @db.Text
  unit            String  @db.VarChar(80)

  unitPrice          Decimal @db.Decimal(12, 2)
  discountPercentage Decimal @default(0) @db.Decimal(5, 2)
  finalUnitPrice     Decimal @db.Decimal(12, 2)

  quantity  Int
  lineTotal Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id String @id @default(uuid()) @db.Uuid

  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  fromStatus OrderStatus?
  toStatus   OrderStatus

  changedByUserId String? @db.Uuid
  changedByUser   User?   @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  note String? @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([orderId, createdAt])
  @@index([changedByUserId])
}

model CouponUsage {
  id String @id @default(uuid()) @db.Uuid

  couponId String @db.Uuid
  userId   String @db.Uuid
  orderId  String @unique @db.Uuid

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  usedAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([couponId])
  @@index([userId])
  @@index([couponId, userId])
}

model Session {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash     String @unique @db.VarChar(64)
  csrfTokenHash String @db.VarChar(64)

  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
}
